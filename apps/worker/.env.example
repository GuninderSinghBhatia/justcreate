# Supabase: read from apps/web/.env.local when not set here.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# Vision analysis + cluster naming. Set ONE of these (Claude is used if both are set).
# With neither, the worker falls back to metadata/colour tags (weaker, but the pipeline still runs).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Optional overrides
# ANALYSIS_MODEL=claude-haiku-5-5
# NAMING_MODEL=claude-sonnet-5-5
# CLIP_MODEL=ViT-B-32
# CLIP_PRETRAINED=laion2b_s34b_b79k
# POLL_SECONDS=5
