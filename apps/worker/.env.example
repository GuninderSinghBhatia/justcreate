# Supabase: read from apps/web/.env.local when not set here.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# Vision analysis + cluster naming + design.md. Set at least one key. Default order when several
# are set: Claude, Groq, Gemini; LLM_PROVIDER forces one. With none, the worker falls back to
# metadata/colour tags (weaker, but the pipeline still runs).
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
# GROQ_VISION_MODEL=qwen/qwen3.8-27b      # per-image analysis (must accept images)
# GROQ_TEXT_MODEL=openai/gpt-oss-120b     # cluster names + design.md
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_NAMING_MODEL=gemini-3.5-flash
# ANALYSIS_MODEL=claude-haiku-5-5
# NAMING_MODEL=claude-sonnet-5-5
# CLIP_MODEL=ViT-B-32
# CLIP_PRETRAINED=laion2b_s34b_b79k
# POLL_SECONDS=5
