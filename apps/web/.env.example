# Supabase → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Publishable key: safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: SERVER ONLY. Never prefix with NEXT_PUBLIC_, never ship to the extension.
SUPABASE_SECRET_KEY=sb_secret_...

# Public address of this site: magic-link emails point here (no trailing slash).
SITE_URL=http://localhost:3100
# Behind a proxy that appends the caller's address to X-Forwarded-For (most hosts): 1. Unset = rate
# limits treat all callers as one (right for local use; never trusts a client-sent header).
# TRUSTED_PROXY_HOPS=1

# Where the Python worker listens (apps/worker). Optional: the worker also polls the jobs table.
WORKER_URL=http://127.0.0.1:8100
